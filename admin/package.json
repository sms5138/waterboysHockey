{
  "name": "waterboys-admin",
  "version": "1.0.13",
  "private": true,
  "description": "GUI installer and status dashboard for the Waterboys video server",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.js",
    "bump": "node scripts/bump-version.js",
    "build": "npm run bump && electron-builder --win nsis --x64",
    "build:dir": "npm run bump && electron-builder --win nsis --x64 --dir",
    "build:nobump": "electron-builder --win nsis --x64"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.waterboyshockey.admin",
    "productName": "Waterboys",
    "copyright": "Copyright (c) Waterboys Hockey",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "build/*.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!node_modules",
          "!node_modules/**",
          "!config.json",
          "!logs/**",
          "!**/.DS_Store"
        ]
      },
      {
        "from": "../server/node_modules",
        "to": "server/node_modules"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WaterboysSetup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Waterboys",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    }
  }
}
